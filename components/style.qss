    padding: 5px;
}

#send_button {
    background-color: #0078d7;
    padding: 7px;
    border-radius: 5px;
    font-weight: normal;
}

#send_button:disabled {
    background-color: #2e2e32;
}

QTableWidget::item:selected {
    background-color: transparent;
}

#delete_header_item_button {
    border-radius: 5px;
}

#body_content_type_tab_widget QTabBar::tab {
    padding: 3px 10px;
    font-size: 11px;
    background: transparent;
}

#body_content_type_tab_widget QTabBar::tab:selected {
    /* background: #2b2b36; */
    border-bottom: 1px solid #0078d7;
    /* color: #ffffff; */
}

